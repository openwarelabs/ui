{
    "name": "@openwarelabs/blocks",
    "version": "0.6.0",
    "description": "Openware UI blocks: whole page sections (heroes and more) as React components that take their content as props.",
    "license": "MIT",
    "author": "Alexander Silver",
    "homepage": "https://github.com/openwarelabs/ui/tree/main/blocks#readme",
    "bugs": {
        "url": "https://github.com/openwarelabs/ui/issues"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./styles.css": "./dist/styles.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "peerDependencies": {
        "@openwarelabs/ui": "^0.6.0",
        "react": ">=18",
        "react-dom": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/openwarelabs/ui.git",
        "directory": "blocks"
    },
    "keywords": [
        "react",
        "components",
        "blocks",
        "hero",
        "landing-page",
        "openware-ui"
    ]
}
