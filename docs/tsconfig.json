{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@openwarelabs/ui": ["src/index.ts"],
      "@openwarelabs/blocks": ["blocks/src/index.ts"],
      "@/*": ["src/*"],
      "@blocks/*": ["blocks/src/*"],
      "@docs/*": ["docs/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../src", "../blocks/src"],
  "exclude": ["./snippets"]
}
