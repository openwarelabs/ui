{
  "name": "@openwarelabs/ui",
  "version": "0.5.0",
  "description": "Openware UI: React components and design tokens — midnight and brass, tactile buttons and Inter, in light and dark.",
  "license": "MIT",
  "author": "Alexander Silver",
  "homepage": "https://github.com/openwarelabs/ui#readme",
  "bugs": {
    "url": "https://github.com/openwarelabs/ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/docs.mjs dev",
    "build": "node scripts/build-tokens.mjs && node scripts/build.mjs && tsc -p tsconfig.build.json && node scripts/build-types.mjs",
    "docs:build": "node scripts/docs.mjs build",
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit && tsc -p docs/tsconfig.json",
    "contrast": "node scripts/check-contrast.mjs",
    "blocks:check": "node scripts/check-blocks.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react-colorful": "5.6.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "culori": "^4.0.1",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openwarelabs/ui"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "design-tokens"
  ]
}
