{
  "name": "@openwarelabs/eslint-plugin-ui",
  "version": "0.24.0",
  "description": "ESLint rules for code written with Openware UI: the library's components instead of raw controls or look-alikes, real props and values, labelled inputs, and tokens instead of hard-coded colours.",
  "license": "MIT",
  "author": "Alexander Silver",
  "homepage": "https://openwarelabs.github.io/ui/",
  "bugs": {
    "url": "https://github.com/openwarelabs/ui/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwarelabs/ui.git",
    "directory": "eslint"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react",
    "components",
    "design-system",
    "openware-ui"
  ]
}
